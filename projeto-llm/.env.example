# Copie para .env e preencha; nenhum valor é versionado neste exemplo.
LLM_BASE_URL=
LLM_MODELO=
OPENAI_API_KEY=
# Opcional: pasta de bancos/checkpoints/logs operacionais. Padrão: runtime/.
AGENTE_RUNTIME=
# Tarifas USD por milhão de tokens. Em servidor local sem cobrança, use zero.
LLM_PRECO_ENTRADA_USD_MILHAO=
LLM_PRECO_SAIDA_USD_MILHAO=
# Benchmark de candidatos; estes endpoints só são chamados pelo comando de benchmark.
BENCH_LOCAL_BASE_URL=
BENCH_LOCAL_MODELO=
BENCH_LOCAL_API_KEY=
BENCH_GROQ_BASE_URL=
BENCH_GROQ_API_KEY=
BENCH_GROQ_MODELO_MEDIO=
BENCH_GROQ_MODELO_GRANDE=
