# Variáveis de ambiente da Parte 1 — SEM NENHUM VALOR (regra do enunciado:
# ".env.example dentro, com os nomes das variáveis e nenhum valor").
#
#   cp .env.example .env     e preencha os três campos abaixo.
#
# Trocar de provedor é trocar estas TRÊS variáveis — o código não muda.
# É exatamente o ponto do item 4.1 do enunciado.

# ---------------------------------------------------------------- obrigatórias

# Endpoint compatível com a API da OpenAI.
LLM_BASE_URL=

# O identificador do modelo, como o provedor o chama.
LLM_MODELO=

# A chave. O nome é OPENAI_API_KEY porque é a variável que o SDK da OpenAI
# procura; o VALOR é a chave do provedor que você escolheu acima.
OPENAI_API_KEY=

# ------------------------------------------------- os três candidatos de docs/modelos.md
#
# Os valores estão omitidos de propósito. Copie o bloco que for usar para as
# variáveis acima e preencha a chave.
#
#  1) gemma-4-e4b — LOCAL (o escolhido). Servidor compatível com OpenAI
#     rodando na máquina do grupo, exposto por um túnel Cloudflare.
#     LLM_BASE_URL=https://<seu-tunel>.trycloudflare.com/v1
#     LLM_MODELO=google/gemma-4-e4b
#     OPENAI_API_KEY=<qualquer valor não-vazio; o servidor local não valida>
#
#  2) qwen3.8-27b — Groq. Chave em https://console.groq.com/keys
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODELO=qwen/qwen3.8-27b
#     OPENAI_API_KEY=<sua chave gsk_...>
#
#  3) gpt-oss-120b — Groq, mesma chave do item 2.
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODELO=openai/gpt-oss-120b
#     OPENAI_API_KEY=<sua chave gsk_...>

# ------------------------------------------------- opcional: src/benchmark.py
#
# O benchmark do item 3.3 precisa falar com os três candidatos na MESMA
# execução, então ele lê estas variáveis extras em vez das de cima.
# Sem elas, benchmark.py roda só o provedor configurado acima.

BENCH_LOCAL_BASE_URL=
BENCH_LOCAL_MODELO=
BENCH_LOCAL_API_KEY=

BENCH_GROQ_BASE_URL=
BENCH_GROQ_API_KEY=
BENCH_GROQ_MODELO_MEDIO=
BENCH_GROQ_MODELO_GRANDE=
